# Token de autenticação do chat, com escopo de escrita.
# https://twitch.tv/irc
TWITCHKEY=

# Usuário do bot (o mesmo que autentica com TWITCHKEY).
TWITCH_USER=

# Canais para entrar, separados por vírgula.
TWITCH_CHANNELS=

# Modelo usado no Ollama. Instale com: ollama pull <modelo>
OLLAMA_MODEL=

# Caminho do banco SQLite, relativo ao diretório de execução.
DB_PATH=
